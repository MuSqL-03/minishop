
{% extends 'base.html.twig' %}

{% block title %}Mon panier - MiniShop{% endblock %}

{% block body %}

{# EN-TETE #}
<section class="py-5" style="background:#f7f4ef;">
    <div class="container text-center">
        <span class="text-uppercase fw-bold text-accent small">
            MiniShop
        </span>

        <h1 class="display-5 fw-bold mt-2">
            <i class="bi bi-cart3"></i> Mon panier
        </h1>

        <p class="text-secondary mb-0">
            Retrouvez les produits que vous avez sélectionnés.
        </p>
    </div>
</section>


<div class="container py-5">

    {# MESSAGES #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success rounded-3 border-0 shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i>
            {{ message }}
        </div>
    {% endfor %}


    {% if items is empty %}

        {# PANIER VIDE #}
        <div class="text-center py-5">

            <div class="mb-4">
                <i class="bi bi-cart-x display-1 text-secondary"></i>
            </div>

            <h3 class="fw-bold">Votre panier est vide</h3>

            <p class="text-secondary">
                Vous n'avez pas encore ajouté de produits.
            </p>

            <a href="{{ path('app_product_index') }}"
               class="btn btn-shop mt-3">
                <i class="bi bi-shop me-2"></i>
                Découvrir la boutique
            </a>

        </div>

    {% else %}

        <div class="row g-4">

            {# LISTE DES PRODUITS #}
            <div class="col-lg-8">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0">
                        Vos articles
                    </h4>

                    <span class="text-secondary small">
                        {{ items|length }} article(s) différent(s)
                    </span>
                </div>


                {% for item in items %}

                    <div class="card border-0 shadow-sm rounded-4 mb-3">

                        <div class="card-body p-3 p-md-4">

                            <div class="row align-items-center g-3">

                                {# IMAGE #}
                                <div class="col-4 col-md-3">

                                    {% if item.product.image %}

                                        <img
                                            src="{{ item.product.image }}"
                                            alt="{{ item.product.name }}"
                                            class="img-fluid rounded-3 w-100"
                                            style="height:120px; object-fit:cover;"
                                            loading="lazy"
                                        >

                                    {% else %}

                                        <div class="rounded-3 d-flex align-items-center justify-content-center"
                                             style="height:120px; background:#f7f4ef;">
                                            <i class="bi bi-image display-5 text-secondary"></i>
                                        </div>

                                    {% endif %}

                                </div>


                                {# INFORMATIONS #}
                                <div class="col-8 col-md-5">

                                    <span class="text-accent small fw-bold text-uppercase">
                                        MiniShop
                                    </span>

                                    <h5 class="fw-bold mt-1 mb-2">
                                        {{ item.product.name }}
                                    </h5>

                                    <p class="text-secondary small mb-2">
                                        {{ item.product.price|number_format(2, ',', ' ') }} € / unité
                                    </p>


                                    {# QUANTITE #}
                                    <div class="d-flex align-items-center gap-2">

                                        <form action="{{ path('app_cart_decrease', {'id': item.product.id}) }}"
                                              method="POST">

                                            <button type="submit"
                                                    class="btn btn-outline-dark btn-sm rounded-circle"
                                                    aria-label="Diminuer la quantité">
                                                <i class="bi bi-dash"></i>
                                            </button>

                                        </form>

                                        <span class="fw-bold px-2">
                                            {{ item.quantity }}
                                        </span>

                                        <form action="{{ path('app_cart_increase', {'id': item.product.id}) }}"
                                              method="POST">

                                            <button type="submit"
                                                    class="btn btn-outline-dark btn-sm rounded-circle"
                                                    aria-label="Augmenter la quantité">
                                                <i class="bi bi-plus"></i>
                                            </button>

                                        </form>

                                    </div>

                                </div>


                                {# SOUS-TOTAL ET SUPPRESSION #}
                                <div class="col-12 col-md-4 text-md-end">

                                    <h5 class="fw-bold mb-2">
                                        {{ item.subtotal|number_format(2, ',', ' ') }} €
                                    </h5>

                                    <form action="{{ path('app_cart_remove', {'id': item.product.id}) }}"
                                          method="POST">

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash me-1"></i>
                                            Supprimer
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                {% endfor %}


                {# VIDER LE PANIER #}
                <form action="{{ path('app_cart_clear') }}"
                      method="POST"
                      onsubmit="return confirm('Voulez-vous vraiment vider votre panier ?');">

                    <button type="submit"
                            class="btn btn-outline-danger btn-sm mt-2">
                        <i class="bi bi-trash me-2"></i>
                        Vider tout le panier
                    </button>

                </form>

            </div>


            {# RECAPITULATIF #}
            <div class="col-lg-4">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-4">
                            Récapitulatif
                        </h4>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-secondary">
                                Sous-total
                            </span>

                            <strong>
                                {{ total|number_format(2, ',', ' ') }} €
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-secondary">
                                Livraison
                            </span>

                            <span class="text-success fw-semibold">
                                À définir
                            </span>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <span class="fw-bold">
                                Total
                            </span>

                            <h3 class="fw-bold mb-0">
                                {{ total|number_format(2, ',', ' ') }} €
                            </h3>

                        </div>


                        {# COMMANDER #}
                        <a href="{{ path('app_order') }}"
                           class="btn btn-shop w-100 py-3">

                            <i class="bi bi-bag-check me-2"></i>
                            Passer la commande

                        </a>


                        <a href="{{ path('app_product_index') }}"
                           class="btn btn-outline-dark w-100 mt-3 py-2">

                            <i class="bi bi-arrow-left me-2"></i>
                            Continuer mes achats

                        </a>


                        <hr class="my-4">


                        <div class="text-center">

                            <i class="bi bi-shield-check fs-3 text-success"></i>

                            <p class="small text-secondary mt-2 mb-0">
                                Votre commande sera enregistrée après validation.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    {% endif %}

</div>

{% endblock %}
