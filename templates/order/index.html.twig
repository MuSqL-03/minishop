
{% extends 'base.html.twig' %}

{% block title %}Commander - MiniShop{% endblock %}

{% block body %}
<div class="container py-5">

    {% if order is not null %}

        <div class="text-center py-5">
            <i class="bi bi-check-circle-fill text-success display-1"></i>

            <h1 class="mt-4">Commande confirmée !</h1>

            <p class="text-muted">
                Merci {{ order.customerName }} pour votre commande.
            </p>

            <h4 class="mt-4">
                Commande n°{{ order.id }}
            </h4>

            <h3 class="mt-3">
                Total : {{ order.total|number_format(2, ',', ' ') }} €
            </h3>

            <p class="mt-3">Statut : {{ order.status }}</p>

            <a href="{{ path('app_product_index') }}" class="btn btn-dark mt-3">
                Continuer mes achats
            </a>
        </div>

    {% else %}

        <div class="row justify-content-center">
            <div class="col-md-7">

                <h1 class="mb-4">Finaliser ma commande</h1>

                <div class="card border-0 shadow-sm p-4">

                    <form method="POST" action="{{ path('app_order') }}">

                        <div class="mb-3">
                            <label class="form-label">Nom complet</label>
                            <input type="text" name="customerName"
                                   class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Adresse email</label>
                            <input type="email" name="customerEmail"
                                   class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Téléphone</label>
                            <input type="tel" name="customerPhone"
                                   class="form-control" required>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Adresse de livraison</label>
                            <textarea name="customerAddress"
                                      class="form-control"
                                      rows="3" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 py-3">
                            Confirmer ma commande
                        </button>

                    </form>

                </div>
            </div>
        </div>

    {% endif %}

</div>
{% endblock %}
